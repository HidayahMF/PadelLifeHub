# Copy this file to .env and fill in real values
#   cp .env.example .env

# MongoDB connection string (MongoDB Atlas or local)
# e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/lifehub
MONGODB_URI=

# Secret used to sign JWT tokens. Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Token lifetime (optional, default is JWT library default)
JWT_EXPIRES_IN=30d

# Google OAuth Client ID (Web application) for "Continue with Google".
# Created in Google Cloud Console → APIs & Services → Credentials.
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=

# Allowed CORS origin for the frontend (optional, defaults to http://localhost:4200)
CLIENT_URL=http://localhost:4200

# API port (optional, defaults to 5000)
PORT=5000

# Email provider (Resend). Leave empty to disable email (password-reset emails
# and reminder emails will not be sent; dev still returns the reset token).
#   https://resend.com → API Keys
RESEND_API_KEY=
# Sender address. Must be from a verified domain, or leave default (onboarding@resend.dev).
EMAIL_FROM=LifeHub <onboarding@resend.dev>

# Avatar storage. Set UPLOAD_STORAGE=cloudinary for production (Vercel's
# filesystem is ephemeral). Leave unset to store avatars in ./uploads (dev).
#   https://cloudinary.com → Dashboard shows Cloud Name / API Key / API Secret
UPLOAD_STORAGE=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secret that guards the external cron endpoint (POST /api/cron/tick).
# Required in production — cron-job.org sends it as the `x-cron-secret` header.
CRON_SECRET=

# Schedulers: in production (NODE_ENV=production) the in-process timers are
# disabled and you must trigger POST /api/cron/tick from an external cron.
# Set RUN_SCHEDULERS=true to force in-process timers in any environment.
RUN_SCHEDULERS=false

# Set to 'production' in deployed environments (hides error details, disables
# in-process schedulers, never returns password-reset tokens in responses).
NODE_ENV=development
